# --- servidor ---
PORT=3000
NODE_ENV=development

# --- IA (clave provista por la organizacion, SOLO para la IA del producto) ---
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=20000

# --- email (EnvialoSimple Transaccional) ---
EMAIL_MODE=mock
ENVIALOSIMPLE_API_KEY=
ENVIALOSIMPLE_FROM=
ENVIALOSIMPLE_BASE=https://api.envialosimple.email

# --- cuentas de usuario (APAGADAS por defecto) ---
# En true habilita /login, /registro y /config y crea las tablas users_*.
# En false la app se comporta igual que siempre y esas URLs dan 404.
AUTH_ENABLED=false

# --- base de datos ---
DB_PATH=data/mostrador.sqlite
