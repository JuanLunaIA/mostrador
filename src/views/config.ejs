<%
  // quotes.created_at viene de SQLite en UTC ("YYYY-MM-DD HH:MM:SS").
  const fecha = (valor) => {
    const d = new Date(String(valor || '').replace(' ', 'T') + 'Z');
    return Number.isNaN(d.getTime()) ? '—'
      : d.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'America/Argentina/Buenos_Aires' });
  };
  const estado = (valor) => valor === 'sent'
    ? { texto: 'Enviado', clase: 'badge-success' }
    : valor === 'draft' ? { texto: 'Borrador', clase: 'badge-warning' } : { texto: valor || '—', clase: '' };
%><!doctype html>
<html lang="es" data-theme="light"><head><%- include('partials/head', {
  title: 'Mi cuenta',
  desc: 'Tus datos y los presupuestos de Mostrador asociados a tu email.',
  noindex: true
}) %></head>
<body class="min-h-screen bg-slate-50 py-10">
<main class="mx-auto w-full max-w-2xl space-y-3">

  <div class="rounded-2xl bg-white p-6 shadow-sm">
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="text-xs uppercase tracking-[0.2em] text-slate-400">Mostrador · mi cuenta</div>
        <h1 class="mt-1 text-2xl font-extrabold"><%= usuario.nombre || 'Tu cuenta' %></h1>
        <p class="text-sm text-slate-500"><%= usuario.email %></p>
      </div>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-sm btn-ghost" type="submit">Salir</button>
      </form>
    </div>
  </div>

  <% if (ok) { %><p class="rounded-xl bg-white p-4 text-sm text-emerald-700 shadow-sm"><%= ok %></p><% } %>
  <% if (error) { %><p class="rounded-xl bg-white p-4 text-sm text-amber-700 shadow-sm"><%= error %></p><% } %>

  <section class="rounded-2xl bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold">Tus datos</h2>
    <p class="mt-1 text-sm text-slate-500">El email es el que usamos para vincular los presupuestos que pediste.</p>
    <form method="post" action="/config/perfil" class="mt-4 grid gap-4 sm:grid-cols-2">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="block text-sm">
        <span class="font-semibold">Nombre</span>
        <input class="input mt-1 w-full" type="text" name="nombre" value="<%= usuario.nombre || '' %>" autocomplete="name" maxlength="120">
      </label>
      <label class="block text-sm">
        <span class="font-semibold">Email</span>
        <input class="input mt-1 w-full" type="email" name="email" value="<%= usuario.email %>" autocomplete="email" required>
      </label>
      <div>
        <button class="btn btn-neutral" type="submit">Guardar cambios</button>
      </div>
    </form>
  </section>

  <section class="rounded-2xl bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold">Cambiar contraseña</h2>
    <p class="mt-1 text-sm text-slate-500">Te pedimos la actual para confirmar que sos vos. Al cambiarla se cierran las otras sesiones abiertas.</p>
    <form method="post" action="/config/password" class="mt-4 grid gap-4 sm:grid-cols-2">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="block text-sm">
        <span class="font-semibold">Contraseña actual</span>
        <input class="input mt-1 w-full" type="password" name="actual" autocomplete="current-password" required>
      </label>
      <label class="block text-sm">
        <span class="font-semibold">Contraseña nueva</span>
        <input class="input mt-1 w-full" type="password" name="nueva" autocomplete="new-password" minlength="8" required>
      </label>
      <label class="block text-sm">
        <span class="font-semibold">Repetí la nueva</span>
        <input class="input mt-1 w-full" type="password" name="repetida" autocomplete="new-password" minlength="8" required>
      </label>
      <div>
        <button class="btn btn-neutral" type="submit">Cambiar contraseña</button>
      </div>
    </form>
  </section>

  <section class="rounded-2xl bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold">Mis presupuestos</h2>
    <p class="mt-1 text-sm text-slate-500">Los últimos presupuestos generados con tu email como email del cliente.</p>
    <% if (presupuestos.length === 0) { %>
      <p class="mt-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-500">Todavía no hay presupuestos con tu email. Pedí uno desde <a class="link" href="/">el mostrador</a> dejando este mismo email en el mensaje.</p>
    <% } else { %>
      <table class="mt-4 w-full text-sm">
        <thead><tr class="border-b border-slate-200 text-slate-500">
          <th class="py-2 text-left font-medium">Presupuesto</th>
          <th class="py-2 text-left font-medium">Cliente</th>
          <th class="py-2 text-right font-medium">Total</th>
          <th class="py-2 text-right font-medium">Estado</th>
        </tr></thead>
        <tbody>
          <% presupuestos.forEach((p) => { const e = estado(p.estado); %>
            <tr class="border-b border-slate-100">
              <td class="py-2">
                <a class="link font-semibold" href="/q/<%= p.token %>"><%= p.token %></a>
                <div class="text-xs text-slate-500"><%= fecha(p.fecha) %> · <%= p.items %> ítem<%= p.items === 1 ? '' : 's' %></div>
              </td>
              <td class="py-2"><%= p.cliente || 'Cliente mostrador' %></td>
              <td class="py-2 text-right font-semibold">$<%= p.totalArs.toLocaleString('es-AR') %></td>
              <td class="py-2 text-right"><span class="badge badge-sm <%= e.clase %>"><%= e.texto %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <p class="text-xs text-slate-500"><a class="link" href="/">Volver al mostrador</a> · Si querés cerrar tu cuenta, escribinos desde <a class="link" href="/contratar">contacto</a>.</p>
</main>
</body></html>
